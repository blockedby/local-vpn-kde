<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.local-vpn-kde.configure">
    <description>Configure the native Local VPN gateway</description>
    <message>Administrator authorization is required to configure Local VPN</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/local-vpn-kde/local-vpn-kde.bin</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">native-configure</annotate>
  </action>
</policyconfig>
